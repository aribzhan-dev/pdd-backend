# --- Application ---
APP_NAME=PDD API
DEBUG=false
# Interactive API docs at /docs. Turn on temporarily when handing the API to
# another developer, then turn it off again.
ENABLE_DOCS=false
CORS_ORIGINS=["https://example.kz"]

# --- Database (async DSN, asyncpg driver) ---
# Local development uses the docker-compose service on port 55432.
# On the server PostgreSQL runs natively, so the port is the default 5432.
DATABASE_URL=postgresql+asyncpg://pdd:CHANGE_ME@localhost:5432/pdd

# --- Security ---
# Generate a fresh one per environment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_48_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Bootstrap admin (used by scripts/create_admin.py) ---
ADMIN_IIN=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_SURNAME=Root

# --- Media ---
# false: video URLs point at the platforms the clips came from, so the server
#        stores no video at all. This is what production uses.
# true : this service serves the local store at MEDIA_URL_PREFIX (development).
MEDIA_SERVE_LOCAL=false
MEDIA_ROOT=../media_store
MEDIA_URL_PREFIX=/media
MEDIA_ORIGIN_OTAN=https://otan-shymkent.kz
MEDIA_ORIGIN_PDDTEST=https://media.pddtest.kz

# --- Sign-in brute-force guard ---
# After LOGIN_MAX_ATTEMPTS failed sign-ins from one IP within
# LOGIN_WINDOW_MINUTES, that address is locked for LOGIN_BLOCK_MINUTES.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
# On when the app sits behind nginx (the real client IP is in X-Forwarded-For).
# Off only if the app is exposed directly, where that header could be forged.
TRUST_PROXY_HEADERS=true

# --- HTTP security headers ---
# Send Strict-Transport-Security. true in production (served over HTTPS);
# false for plain-HTTP local development.
ENABLE_HSTS=true
